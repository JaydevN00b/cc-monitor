    "start": "node bin/cc-monitor.js",
    "test": "node test/smoke.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "claude",
    "claude-code",
    "monitor",
    "usage",
    "statusline",
    "hooks"
  ],
  "license": "MIT",
  "dependencies": {
    "ws": "^8.23.0"
  }
}
