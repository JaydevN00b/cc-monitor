{
  "name": "cc-live-monitor",
  "version": "0.2.0",
  "description": "Live dot-matrix session monitor for Claude Code: subscription limits, context, tokens/min, models, agents and file changes in a window next to your terminal.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JaydevN00b/cc-monitor.git"
  },
  "homepage": "https://github.com/JaydevN00b/cc-monitor#readme",
  "bugs": {
    "url": "https://github.com/JaydevN00b/cc-monitor/issues"
  },
  "bin": {
    "cc-live-monitor": "bin/cc-monitor.js",
    "cc-monitor": "bin/cc-monitor.js"
  },
  "files": [
    "bin/",
    "src/",
    "forwarders/",
    "public/",
    "README.md"
  ],
  "scripts": {
    "start": "node bin/cc-monitor.js",
    "test": "node test/smoke.js && node --test test/attention.test.js test/agents.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "claude",
